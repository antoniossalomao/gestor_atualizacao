# Copie este arquivo para ".env" e ajuste os valores conforme o seu ambiente.
# O ".env" real (com o segredo de verdade) nunca deve ser versionado no git.
#
# Este arquivo guarda só infraestrutura e segredos. As regras da EQUIPE
# (URL pública, webhook do Discord, intervalos, dias até arquivar...) moram
# no banco e são editadas na tela Administração, valendo na hora -- ver a
# seção "Valores iniciais" no fim deste arquivo.

# Porta em que o servidor HTTP vai escutar.
PORT=3000

# Caminho do arquivo de banco de dados SQLite. Se voce ja tem um
# "gestao.db" do app antigo (Python/Tkinter), pode apontar direto pra ele
# aqui -- o schema e compativel, os dados continuam funcionando.
DB_PATH=./data/gestao.db

# Texto usado para "assinar" os cookies de sessao de login. OBRIGATORIO
# trocar: o servidor se recusa a subir com este valor de exemplo (que e
# publico) ou sem valor nenhum. Use um texto longo e aleatorio (ex.: gerado com
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
SESSION_SECRET=troque-este-valor-em-producao

# "true" quando o servidor roda atras de HTTPS (proxy reverso, hospedagem
# na internet) -- faz o cookie de sessao exigir conexao segura. Deixe
# "false" para uso em rede local sem HTTPS.
SESSION_SECURE=false

# Token compartilhado entre os agentes locais e a API.
AGENT_API_TOKEN=troque-por-um-token-longo-e-aleatorio


# "true" quando há um proxy reverso confiável na frente do Node (Caddy, nginx...)
# terminando o HTTPS. Com isso o Express usa o cabeçalho X-Forwarded-For para
# descobrir o IP real do cliente -- necessário para o cookie de sessão funcionar
# com SESSION_SECURE=true e para o rate limiter do login bloquear o IP correto.
# Deixe "false" (padrão) em rede local sem proxy: com "true" sem proxy real,
# qualquer cliente pode forjar X-Forwarded-For e burlar o rate limiter de login
# usando IPs diferentes a cada tentativa.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Valores iniciais (opcionais) das regras da equipe
#
# Estas quatro NÃO são mais configuração: viraram regras da equipe, no banco,
# editadas em Administração e valendo na hora. O servidor só olha para elas
# UMA vez, na primeira subida em que a regra ainda não existe no banco -- é
# o que traz, sem perda, o que uma instalação antiga já tinha aqui. Depois
# disso, mudar aqui não muda nada: mude na tela.
#
# Deixe comentadas numa instalação nova. Em especial PUBLIC_URL: com
# "localhost", o link de download que o agente recebe aponta para ele mesmo.
#
# PUBLIC_URL=http://192.168.0.10:3000
# DISCORD_WEBHOOK_URL=
# ALERTA_AGENTES_INTERVALO_MINUTOS=15
# AGENDAMENTO_ARQUIVAR_DIAS=30
