# Copie este arquivo para ".env" e ajuste os valores conforme o seu ambiente.
# O ".env" real (com o segredo de verdade) nunca deve ser versionado no git.
#
# AGENT_API_TOKEN, PUBLIC_URL, DISCORD_WEBHOOK_URL,
# ALERTA_AGENTES_INTERVALO_MINUTOS e AGENDAMENTO_ARQUIVAR_DIAS também podem
# ser vistos e editados pelo navegador, por um administrador: Configurações →
# Sistema → "Configuração da API". A tela grava neste mesmo arquivo -- só
# passa a valer depois que o servidor reinicia, igual editar aqui na mão.

# Porta em que o servidor HTTP vai escutar.
PORT=3000

# Caminho do arquivo de banco de dados SQLite. Se voce ja tem um
# "gestao.db" do app antigo (Python/Tkinter), pode apontar direto pra ele
# aqui -- o schema e compativel, os dados continuam funcionando.
DB_PATH=./data/gestao.db

# Texto usado para "assinar" os cookies de sessao de login. OBRIGATORIO
# trocar: o servidor se recusa a subir com este valor de exemplo (que e
# publico) ou sem valor nenhum. Use um texto longo e aleatorio (ex.: gerado com
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
SESSION_SECRET=troque-este-valor-em-producao

# "true" quando o servidor roda atras de HTTPS (proxy reverso, hospedagem
# na internet) -- faz o cookie de sessao exigir conexao segura. Deixe
# "false" para uso em rede local sem HTTPS.
SESSION_SECURE=false

# Token compartilhado entre os agentes locais e a API.
AGENT_API_TOKEN=troque-por-um-token-longo-e-aleatorio

# URL pública usada nos links de download enviados aos agentes.
PUBLIC_URL=http://localhost:3000

# URL de webhook de um canal do Discord (Configurações do Canal >
# Integrações > Webhooks > Novo Webhook > Copiar URL). Opcional: se deixar
# vazio, o app simplesmente não manda nada pro Discord. Quando configurado,
# toda atualização nova cadastrada avisa o canal automaticamente
# (importação em massa via planilha não avisa, para não gerar spam), e o
# app passa a avisar sozinho quando um agente do Atualizador automático
# fica offline (24h+ sem contato) ou reporta erro -- ver
# ALERTA_AGENTES_INTERVALO_MINUTOS abaixo.
DISCORD_WEBHOOK_URL=

# De quanto em quanto tempo (minutos) o app confere a situação dos agentes
# C# pra decidir se precisa avisar o Discord. Só tem efeito com
# DISCORD_WEBHOOK_URL configurada -- sem webhook, essa verificação nem
# roda. Padrão: 15.
ALERTA_AGENTES_INTERVALO_MINUTOS=15

# Quantos dias uma tarefa concluída fica na aba Agendamentos antes de sair
# da lista sozinha. Ela não é apagada: continua no filtro "Arquivadas" (e
# continua contando no tempo médio de resolução do Resumo), e o botão
# "Reabrir" traz de volta como "A Fazer". É uma regra da EQUIPE, não uma
# preferência de cada pessoa -- por isso mora aqui, e não no painel de
# Configurações. Padrão: 30.
AGENDAMENTO_ARQUIVAR_DIAS=7

# "true" quando há um proxy reverso confiável na frente do Node (Caddy, nginx...)
# terminando o HTTPS. Com isso o Express usa o cabeçalho X-Forwarded-For para
# descobrir o IP real do cliente -- necessário para o cookie de sessão funcionar
# com SESSION_SECURE=true e para o rate limiter do login bloquear o IP correto.
# Deixe "false" (padrão) em rede local sem proxy: com "true" sem proxy real,
# qualquer cliente pode forjar X-Forwarded-For e burlar o rate limiter de login
# usando IPs diferentes a cada tentativa.
TRUST_PROXY=false
