# Dependências instaladas via npm (recriadas com "npm install").
node_modules/

# Configuração local (segredos, caminho do banco) -- cada ambiente tem o seu.
# ".env.*" (não só ".env" exato) para cobrir cópias de backup do tipo
# ".env.bak"/".env.old" que alguém faça na mão -- um ".env.bak" real chegou a
# ser commitado antes desta regra existir (removido do índice em set/2026;
# o segredo nele já era só o valor de exemplo, então não precisou rotacionar
# nada). ".env.example" é o único ".env.*" que DEVE ir pro git, daí o "!".
.env
.env.*
!.env.example
*.sql

# Banco de dados, backups automáticos e sessões de login: são DADOS reais
# de clientes, não código -- nunca devem ir para o controle de versão
# (o mesmo motivo por trás do .gitignore do projeto Python original).
server/data/

npm-debug.log*
*.log
*.pid

# Backups locais de trabalho (cópias inteiras de client/ e server/src/,
# tiradas antes de mudanças arriscadas para poder reverter na hora sem
# depender do histórico do git). Não são parte do código -- são rede de
# segurança de quem está mexendo, redundantes com o próprio commit.
_backup/

# Diretório local do Claude Code (worktrees, configurações da máquina). Hoje
# está vazio, mas num repositório público vale ignorar antes: o que cai ali
# são caminhos e preferências desta máquina, não código do projeto.
.claude/
