# Proxy HTTPS na frente do painel (ver docs/ARQUITETURA.md#adr-0010).
# Passo a passo completo em docs/OPERACAO.md.

{
	# Somente HTTPS (decisão de 29/09/2026): em rede interna ou VM com acesso
	# restrito pela 443, a porta 80 não é necessária.
	# Nota para VM com domínio público DNS (Let's Encrypt): remova
	# "auto_https disable_redirects" e "tls internal" abaixo para emissão
	# automática via desafio HTTP-01 na porta 80.
	auto_https disable_redirects

	# Quem acessa por https://IP não envia SNI ao pedir o certificado (especificação TLS).
	# Defina a variável de ambiente GESTOR_IP com o IP do servidor ao iniciar o Caddy;
	# sem ela, fica em "localhost" e o acesso direto via https://IP não abre.
	default_sni {$GESTOR_IP:localhost}
}

# GESTOR_ENDERECO é o endereço pelo qual a equipe acessa, sem "https://":
# um nome DNS (ex.: painel.suaempresa.com.br ou gestoratualizacao) ou o IP.
# O certificado só vale para os endereços listados aqui.
{$GESTOR_ENDERECO} {
	# Em rede interna / VPN / acesso por IP privado, usa autoridade própria (tls internal).
	# Em servidor com domínio público DNS real, comente/remova "tls internal"
	# para o Caddy emitir e renovar certificado público Let's Encrypt automaticamente.
	tls internal

	# Por padrão encaminha para o Node rodando localmente na mesma máquina (127.0.0.1:3000),
	# com HOST=127.0.0.1 no server/.env. Pode ser sobrescrito via GESTOR_UPSTREAM.
	reverse_proxy {$GESTOR_UPSTREAM:127.0.0.1:3000}
}
