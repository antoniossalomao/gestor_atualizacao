# Convenções de arquivo válidas para qualquer editor que leia .editorconfig
# (VS Code, Visual Studio, JetBrains, Vim com plugin...). Existe para que
# "quem abriu o arquivo com outro editor" não gere um diff inteiro só de
# espaço em branco.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: dois espaços no fim da linha são uma quebra de linha
# significativa, então aparar espaço à direita corromperia o texto.
[*.md]
trim_trailing_whitespace = false

[*.{ps1,psm1}]
end_of_line = crlf

[*.{json,yml,yaml}]
indent_size = 2
